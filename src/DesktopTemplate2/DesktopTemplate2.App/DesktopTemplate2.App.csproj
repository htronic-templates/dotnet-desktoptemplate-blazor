<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="4.2.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Feather" Version="2.0.0" />
    <PackageReference Include="BlazorBlueprint.Icons.FontAwesome" Version="2.0.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Heroicons" Version="2.0.0" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
    <PackageReference Include="BlazorBlueprint.PdfViewer" Version="1.0.0" />
    <PackageReference Include="BlazorBlueprint.Primitives" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" />
    <PackageReference Include="Tailwind.MSBuild" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Test1Lib\Test1Lib.csproj" />
  </ItemGroup>

  <Target Name="PrepareTailwindDependencies"
		  BeforeTargets="BuildTailwind"
		  DependsOnTargets="ResolveReferences;_CopySourceItemsToOutputDirectory">

	<Message Text="BUILDING Test1Lib BEFORE TAILWIND"
             Importance="high" />

	<!-- Ensure the referenced project has been built -->
	<MSBuild Projects="..\Test1Lib\Test1Lib.csproj"
             Targets="CopyFilesToOutputDirectory"
             Properties="Configuration=$(Configuration)" />
  </Target>
  
</Project>
