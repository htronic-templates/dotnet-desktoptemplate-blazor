<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Exclude nested client project from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);DesktopTemplate1.GUI.WebAuto.Client\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesktopTemplate1.App\DesktopTemplate1.App.csproj" />
    <ProjectReference Include="DesktopTemplate1.GUI.WebAuto.Client\DesktopTemplate1.GUI.WebAuto.Client.csproj" />
  </ItemGroup>

</Project>
