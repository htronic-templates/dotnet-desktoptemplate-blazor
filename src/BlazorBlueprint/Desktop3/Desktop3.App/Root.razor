@using BlazorBlueprint.Primitives
<HeadContent>
    <link rel="stylesheet" href="_content/Desktop3.App/css/tailwind.css" />
    <link rel="stylesheet" href="_content/Desktop3.App/css/theme.css" />
    <link rel="stylesheet" href="_content/Desktop3.App/css/custom.css" />
