<HeadContent>
    <link rel="stylesheet" href="_content/Desktop2.App/css/app.css" />
    <link rel="stylesheet" href="_content/Desktop2.App/css/theme.css" />
    <link rel="stylesheet" href="_content/Desktop2.App/css/custom.css" />
</HeadContent>

<Router AppAssembly="@typeof(Root).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
