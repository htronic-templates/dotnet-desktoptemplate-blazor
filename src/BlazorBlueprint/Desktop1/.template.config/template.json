{
  "$schema": "http://json.schemastore.org/template",
  "author": "Hecatron",
  "classifications": ["Desktop", "Application", "C#"],

  // Unique identifier for the template
  "identity": "Htronic.BlazorBlueprint.Desktop1",

  // Displayed by dotnet new list
  "name": "Htronic.BlazorBlueprint.Desktop1",

  // Used with dotnet new
  "shortName": "htronic.blazorblueprint.desktop1",

  // Namespace / csproj name to replace
  "sourceName": "Desktop1",

  "preferNameDirectory": true,
  "tags": {
    "language": "C#",
    "type": "project"
  },

  // Ignore paths
  "sources": [
    {
      "modifiers": [
        {
          "exclude": [
            "**/.vs/**"
          ]
        }
      ]
    }
  ]
}
