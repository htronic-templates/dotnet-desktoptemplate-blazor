root = true

[*.cs]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8
trim_trailing_whitespace = true

# Prefer var when type is obvious
dotnet_style_var_when_type_is_apparent = true:suggestion

# Prefer expression-bodied members
csharp_style_expression_bodied_properties = true:suggestion

# Prefer modern pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion

# Prefer file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:warning

# Sort using directives
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Prefer collection expressions (C# 12+)
dotnet_style_prefer_collection_expression = when_types_loosely_match:suggestion

# Prefer braces
csharp_prefer_braces = when_multiline

# Prefer modern object initialization
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion

# Formatting
csharp_new_line_before_open_brace = none
csharp_indent_case_contents = true
csharp_indent_switch_labels = true

# JetBrains formatting settings
resharper_csharp_indent_method_decl_pars = outside_and_inside
